# CloudWatch alarms on four of the metrics the engine serves at /metrics on its health endpoint, and
# what it takes to read them on Fargate:
#
#   * a bearer token for the health endpoint, generated by an ephemeral resource and written in a
#     write-only argument to a Secrets Manager secret, so neither the plan nor the state holds it.
#     ECS injects it into the engine (PATHWAYS_HEALTH_TOKEN, which the health endpoint reads by
#     default) and into the collector, so /metrics stays authenticated;
#   * the configuration of an OpenTelemetry collector that runs beside the engine in its task (the
#     ecs submodule adds the container): it scrapes /metrics at 127.0.0.1 every 30 seconds, keeps the
#     four families the alarms read and drops every other, sums or takes the extreme over every
#     channel, destination and outcome label so no channel or destination name leaves the task, and
#     writes them as CloudWatch embedded metric format lines to a log group under the deployment's
#     prefix, which CloudWatch turns into metrics in the Pathways namespace;
#   * that log group, encrypted under the deployment's key, and the task role's right to write it;
#   * the four alarms, each publishing to the caller's SNS topic on alarm and on OK.
#
# The metrics in CloudWatch, each with the one dimension Deployment = <name>:
#
#   pathways_store_up                     the minimum: 0 when the engine could not read its database
#   pathways_oldest_pending_age_seconds   the maximum over every destination
#   pathways_messages_refused_total       the bodies refused since the last scrape, every channel
#   pathways_settled_destinations_total   the settlements with outcome "failed" since the last
#                                         scrape, every channel and destination

locals {
  namespace      = "Pathways"
  dimension      = "Deployment"
  metrics_log    = "${var.log_group_prefix}/metrics"
  token_variable = "PATHWAYS_HEALTH_TOKEN"

  # Each family the alarms read, as the collector may name it (with or without the _total or unit
  # suffix, as its Prometheus receiver normalizes names or not), the name it gets in CloudWatch, and
  # how its label sets fold into one.
  families = {
    store_up = {
      names       = ["pathways_store_up"]
      match       = "^pathways_store_up"
      metric_name = "pathways_store_up"
      aggregation = "min"
    }
    oldest_pending_age = {
      names       = ["pathways_oldest_pending_age_seconds", "pathways_oldest_pending_age"]
      match       = "^pathways_oldest_pending_age"
      metric_name = "pathways_oldest_pending_age_seconds"
      aggregation = "max"
    }
    messages_refused = {
      names       = ["pathways_messages_refused_total", "pathways_messages_refused"]
      match       = "^pathways_messages_refused"
      metric_name = "pathways_messages_refused_total"
      aggregation = "sum"
    }
    settled_destinations = {
      names       = ["pathways_settled_destinations_total", "pathways_settled_destinations"]
      match       = "^pathways_settled_destinations"
      metric_name = "pathways_settled_destinations_total"
      aggregation = "sum"
    }
  }

  kept_names = flatten([for f in values(local.families) : f.names])
  settled_condition = join(" or ", [
    for n in local.families.settled_destinations.names : "metric.name == \"${n}\""
  ])

  # The collector's whole configuration. It names the token only as the variable the collector
  # reads it from, never its value.
  collector_config = yamlencode({
    receivers = {
      prometheus = {
        config = {
          scrape_configs = [{
            job_name        = "pathways"
            scrape_interval = "30s"
            scrape_timeout  = "10s"
            metrics_path    = "/metrics"
            scheme          = "http"
            authorization = {
              type        = "Bearer"
              credentials = "$${env:${local.token_variable}}"
            }
            static_configs = [{ targets = ["127.0.0.1:${var.health_port}"] }]
          }]
        }
      }
    }

    processors = {
      # Only the four families leave the task, and of the settlements only those that failed.
      "filter/pathways" = {
        error_mode = "ignore"
        metrics = {
          metric = [
            "not (${join(" or ", [for n in local.kept_names : "name == \"${n}\""])})",
          ]
          datapoint = [
            "(${local.settled_condition}) and attributes[\"outcome\"] != \"failed\"",
          ]
        }
      }

      # Each family under one fixed name, its channel, destination and outcome labels folded away,
      # and the deployment's name as its one label.
      "metricstransform/pathways" = {
        transforms = [
          for key in sort(keys(local.families)) : {
            include    = local.families[key].match
            match_type = "regexp"
            action     = "update"
            new_name   = local.families[key].metric_name
            operations = [
              {
                action    = "add_label"
                new_label = local.dimension
                new_value = var.name
              },
              {
                action           = "aggregate_labels"
                label_set        = [local.dimension]
                aggregation_type = local.families[key].aggregation
              },
            ]
          }
        ]
      }

      batch = {
        timeout = "30s"
      }
    }

    exporters = {
      awsemf = {
        namespace               = local.namespace
        log_group_name          = local.metrics_log
        log_stream_name         = "metrics-collector"
        dimension_rollup_option = "NoDimensionRollup"
        metric_declarations = [{
          dimensions            = [[local.dimension]]
          metric_name_selectors = ["^pathways_"]
        }]
      }
    }

    service = {
      pipelines = {
        metrics = {
          receivers  = ["prometheus"]
          processors = ["filter/pathways", "metricstransform/pathways", "batch"]
          exporters  = ["awsemf"]
        }
      }
    }
  })

  alarm_dimensions = { (local.dimension) = var.name }
}

ephemeral "random_password" "health_token" {
  length  = 48
  special = false
}

resource "aws_secretsmanager_secret" "health_token" {
  name                    = "pathways/${var.name}/health-token"
  description             = "Pathways ${var.name}: the bearer token of the engine's health endpoint, read by the engine and its metrics collector as PATHWAYS_HEALTH_TOKEN"
  kms_key_id              = var.kms_key_arn
  recovery_window_in_days = 7
  tags                    = var.tags
}

resource "aws_secretsmanager_secret_version" "health_token" {
  secret_id                = aws_secretsmanager_secret.health_token.id
  secret_string_wo         = ephemeral.random_password.health_token.result
  secret_string_wo_version = var.health_token_version
}

resource "aws_cloudwatch_log_group" "metrics" {
  name              = local.metrics_log
  retention_in_days = var.log_retention_days
  kms_key_id        = var.kms_key_arn
  tags              = var.tags
}

data "aws_iam_policy_document" "task" {
  statement {
    sid       = "WriteMetrics"
    effect    = "Allow"
    actions   = ["logs:CreateLogStream", "logs:PutLogEvents"]
    resources = ["${aws_cloudwatch_log_group.metrics.arn}:*"]
  }
}

resource "aws_iam_role_policy" "task" {
  name   = "metrics-${var.name}"
  role   = var.task_role_name
  policy = data.aws_iam_policy_document.task.json
}

# The engine could not read its database, or nothing reported at all: a missing minute counts, so a
# stopped engine or a stopped collector fires it too.
resource "aws_cloudwatch_metric_alarm" "store_down" {
  alarm_name          = "pathways-${var.name}-store-down"
  alarm_description   = "Pathways ${var.name}: the engine could not read its database (pathways_store_up below 1), or the engine or its collector stopped reporting, for ${var.store_down_minutes} minute(s)."
  namespace           = local.namespace
  metric_name         = local.families.store_up.metric_name
  dimensions          = local.alarm_dimensions
  statistic           = "Minimum"
  period              = 60
  evaluation_periods  = var.store_down_minutes
  datapoints_to_alarm = var.store_down_minutes
  comparison_operator = "LessThanThreshold"
  threshold           = 1
  treat_missing_data  = "breaching"
  alarm_actions       = [var.sns_topic_arn]
  ok_actions          = [var.sns_topic_arn]
  tags                = var.tags
}

# A delivery has waited too long on some destination: it rises while a destination is down or
# refusing, whatever the traffic. The engine leaves the gauge out while it cannot read its database,
# which the store down alarm covers, so a missing minute does not count here.
resource "aws_cloudwatch_metric_alarm" "oldest_pending_age" {
  alarm_name          = "pathways-${var.name}-oldest-pending-age"
  alarm_description   = "Pathways ${var.name}: a delivery has waited more than ${var.oldest_pending_age_seconds} seconds on a destination for 5 minutes (pathways_oldest_pending_age_seconds)."
  namespace           = local.namespace
  metric_name         = local.families.oldest_pending_age.metric_name
  dimensions          = local.alarm_dimensions
  statistic           = "Maximum"
  period              = 60
  evaluation_periods  = 5
  datapoints_to_alarm = 5
  comparison_operator = "GreaterThanThreshold"
  threshold           = var.oldest_pending_age_seconds
  treat_missing_data  = "notBreaching"
  alarm_actions       = [var.sns_topic_arn]
  ok_actions          = [var.sns_topic_arn]
  tags                = var.tags
}

resource "aws_cloudwatch_metric_alarm" "refused_messages" {
  alarm_name          = "pathways-${var.name}-refused-messages"
  alarm_description   = "Pathways ${var.name}: the sources refused more than ${var.refused_messages_threshold} bodies (unreadable or rejected) in 15 minutes (pathways_messages_refused_total)."
  namespace           = local.namespace
  metric_name         = local.families.messages_refused.metric_name
  dimensions          = local.alarm_dimensions
  statistic           = "Sum"
  period              = 900
  evaluation_periods  = 1
  datapoints_to_alarm = 1
  comparison_operator = "GreaterThanThreshold"
  threshold           = var.refused_messages_threshold
  treat_missing_data  = "notBreaching"
  alarm_actions       = [var.sns_topic_arn]
  ok_actions          = [var.sns_topic_arn]
  tags                = var.tags
}

resource "aws_cloudwatch_metric_alarm" "settled_failed" {
  alarm_name          = "pathways-${var.name}-settled-failed"
  alarm_description   = "Pathways ${var.name}: more than ${var.settled_failed_threshold} messages settled as failed with a destination in 15 minutes (pathways_settled_destinations_total, outcome failed)."
  namespace           = local.namespace
  metric_name         = local.families.settled_destinations.metric_name
  dimensions          = local.alarm_dimensions
  statistic           = "Sum"
  period              = 900
  evaluation_periods  = 1
  datapoints_to_alarm = 1
  comparison_operator = "GreaterThanThreshold"
  threshold           = var.settled_failed_threshold
  treat_missing_data  = "notBreaching"
  alarm_actions       = [var.sns_topic_arn]
  ok_actions          = [var.sns_topic_arn]
  tags                = var.tags
}
