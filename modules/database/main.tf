# PostgreSQL on RDS: one instance, Multi-AZ by default, its storage encrypted under a customer
# managed key, reachable only through the security groups given, and refusing any connection without
# TLS.
#
# The password is generated by an ephemeral resource and passed in write-only arguments, so neither
# the plan nor the state holds it. The same run writes the connection URL, password inside, to a
# Secrets Manager secret, which ECS injects as PATHWAYS_DATABASE_URL. Raise password_version to set
# a new one, or to bring the password and the URL back together when they stop matching (a replaced
# instance, a first apply that failed between the two).
#
# The storage, its backups and the final snapshot use storage_kms_key_arn when the caller gives one,
# so the final snapshot can outlive kms_key_arn.

locals {
  storage_kms_key_arn = coalesce(var.storage_kms_key_arn, var.kms_key_arn)
}

ephemeral "random_password" "this" {
  length  = 40
  special = false
}

resource "aws_db_subnet_group" "this" {
  name       = "pathways-${var.name}"
  subnet_ids = var.subnet_ids
  tags       = var.tags
}

resource "aws_db_parameter_group" "this" {
  name   = "pathways-${var.name}"
  family = var.parameter_group_family
  tags   = var.tags

  # Refuse a connection that does not use TLS.
  parameter {
    name  = "rds.force_ssl"
    value = "1"
  }

  lifecycle {
    create_before_destroy = true
  }
}

resource "aws_db_instance" "this" {
  identifier     = "pathways-${var.name}"
  engine         = "postgres"
  engine_version = var.engine_version
  instance_class = var.instance_class

  allocated_storage     = var.allocated_storage
  max_allocated_storage = var.max_allocated_storage
  storage_type          = "gp3"
  storage_encrypted     = true
  kms_key_id            = local.storage_kms_key_arn

  db_name             = var.database_name
  username            = var.username
  password_wo         = ephemeral.random_password.this.result
  password_wo_version = var.password_version
  port                = 5432

  multi_az               = var.multi_az
  db_subnet_group_name   = aws_db_subnet_group.this.name
  vpc_security_group_ids = var.security_group_ids
  publicly_accessible    = false
  parameter_group_name   = aws_db_parameter_group.this.name
  ca_cert_identifier     = "rds-ca-rsa2048-g1"

  backup_retention_period   = var.backup_retention_days
  copy_tags_to_snapshot     = true
  deletion_protection       = var.deletion_protection
  skip_final_snapshot       = false
  final_snapshot_identifier = "pathways-${var.name}-final"

  auto_minor_version_upgrade  = true
  allow_major_version_upgrade = false

  # Performance Insights and the PostgreSQL log exports stay off: they keep statement text, and the
  # module captures no more about the messages than the engine's own logs do.
  performance_insights_enabled = false

  tags = var.tags
}

resource "aws_secretsmanager_secret" "url" {
  name                    = "pathways/${var.name}/database-url"
  description             = "Pathways ${var.name}: the PostgreSQL connection URL, password inside, read by the engine as PATHWAYS_DATABASE_URL"
  kms_key_id              = var.kms_key_arn
  recovery_window_in_days = 7
  tags                    = var.tags
}

resource "aws_secretsmanager_secret_version" "url" {
  secret_id                = aws_secretsmanager_secret.url.id
  secret_string_wo         = "postgres://${var.username}:${ephemeral.random_password.this.result}@${aws_db_instance.this.address}:${aws_db_instance.this.port}/${var.database_name}"
  secret_string_wo_version = var.password_version
}
