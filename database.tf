# PostgreSQL on RDS: one instance, Multi-AZ by default, its storage encrypted under the module's key,
# reachable only from the engine's security group, and refusing any connection without TLS.
#
# The password is generated by an ephemeral resource and passed in write-only arguments, so neither
# the plan nor the state holds it. The same run writes the connection URL, password inside, to a
# Secrets Manager secret, which ECS injects as PATHWAYS_DATABASE_URL. Raise
# database_password_version to set a new one, or to bring the password and the URL back together
# when they stop matching (a replaced instance, a first apply that failed between the two).
#
# The storage, its backups and the final snapshot use database_kms_key_arn when the caller gives
# one, so the final snapshot can outlive the module's own key.

locals {
  database_kms_key_arn = coalesce(var.database_kms_key_arn, aws_kms_key.this.arn)
}

ephemeral "random_password" "database" {
  length  = 40
  special = false
}

resource "aws_db_subnet_group" "this" {
  name       = "pathways-${var.name}"
  subnet_ids = local.database_subnet_ids
  tags       = local.tags
}

resource "aws_db_parameter_group" "this" {
  name   = "pathways-${var.name}"
  family = var.database_parameter_group_family
  tags   = local.tags

  # Refuse a connection that does not use TLS.
  parameter {
    name  = "rds.force_ssl"
    value = "1"
  }

  lifecycle {
    create_before_destroy = true
  }
}

resource "aws_db_instance" "this" {
  identifier     = "pathways-${var.name}"
  engine         = "postgres"
  engine_version = var.database_engine_version
  instance_class = var.database_instance_class

  allocated_storage     = var.database_allocated_storage
  max_allocated_storage = var.database_max_allocated_storage
  storage_type          = "gp3"
  storage_encrypted     = true
  kms_key_id            = local.database_kms_key_arn

  db_name             = var.database_name
  username            = var.database_username
  password_wo         = ephemeral.random_password.database.result
  password_wo_version = var.database_password_version
  port                = 5432

  multi_az               = var.database_multi_az
  db_subnet_group_name   = aws_db_subnet_group.this.name
  vpc_security_group_ids = [aws_security_group.database.id]
  publicly_accessible    = false
  parameter_group_name   = aws_db_parameter_group.this.name
  ca_cert_identifier     = "rds-ca-rsa2048-g1"

  backup_retention_period   = var.database_backup_retention_days
  copy_tags_to_snapshot     = true
  deletion_protection       = var.deletion_protection
  skip_final_snapshot       = false
  final_snapshot_identifier = "pathways-${var.name}-final"

  auto_minor_version_upgrade  = true
  allow_major_version_upgrade = false

  # Performance Insights and the PostgreSQL log exports stay off: they keep statement text, and the
  # module captures no more about the messages than the engine's own logs do.
  performance_insights_enabled = false

  tags = local.tags
}

resource "aws_secretsmanager_secret" "database_url" {
  name                    = "pathways/${var.name}/database-url"
  description             = "Pathways ${var.name}: the PostgreSQL connection URL, password inside, read by the engine as PATHWAYS_DATABASE_URL"
  kms_key_id              = aws_kms_key.this.arn
  recovery_window_in_days = 7
  tags                    = local.tags
}

resource "aws_secretsmanager_secret_version" "database_url" {
  secret_id                = aws_secretsmanager_secret.database_url.id
  secret_string_wo         = "postgres://${var.database_username}:${ephemeral.random_password.database.result}@${aws_db_instance.this.address}:${aws_db_instance.this.port}/${var.database_name}"
  secret_string_wo_version = var.database_password_version
}
